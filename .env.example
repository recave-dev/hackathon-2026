# Jev (TypeSafe AI System One model) routes meeting utterances to knowledge cards.
# Either a direct TypeSafe key (api.typesafe.ai) ...
TYPESAFE_API_KEY=
# ... or an OpenRouter key (sk-or-...). An sk-or- key in TYPESAFE_API_KEY is detected too.
OPENROUTER_API_KEY=
# Model id on OpenRouter; direct TypeSafe calls use jev-latest.
JEV_MODEL=typesafe/jev-1.13
# Without any key the app falls back to keyword matching.
