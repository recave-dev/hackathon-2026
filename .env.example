# Jev (TypeSafe AI System One model) routes meeting utterances to knowledge cards.
# Either a direct TypeSafe key (api.typesafe.ai) ...
TYPESAFE_API_KEY=
# ... or an OpenRouter key (sk-or-...). An sk-or- key in TYPESAFE_API_KEY is detected too.
OPENROUTER_API_KEY=
# Model id on OpenRouter; direct TypeSafe calls use jev-latest.
JEV_MODEL=typesafe/jev-1.13
# Without any key the app falls back to keyword matching.

# xAI Grok Voice Transcribe powers the microphone (via `npm run stt:proxy`, a local
# WebSocket proxy so the key stays on the server). Without it the browser recogniser is used.
XAI_API_KEY=
STT_PROXY_PORT=3002
# Comma-separated words to boost in recognition; the wake word is the important one.
STT_KEYTERMS=Bolek,Bolku
# Browser-side proxy address (defaults to ws://<host>:3002).
# VITE_STT_WS_URL=ws://localhost:3002

# Open questions ("Bolek, ile zapłaciliśmy za X w Y?") are answered from the whole company graph
# with one LLM call through OpenRouter (same key as above). Any OpenRouter model id works.
ANSWER_MODEL=anthropic/claude-haiku-4.5
# Which graph snapshot to answer from.
GRAPH_DB=knowledge/synthetic/demo-v3-2025-11-19.sqlite
