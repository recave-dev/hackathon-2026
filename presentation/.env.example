# xAI Grok Voice text-to-speech narrates every slide and drives the orb.
# Never commit the real key; copy this file to .env and fill it in.
XAI_API_KEY=
# Any built-in voice from GET https://api.x.ai/v1/tts/voices (eve, ara, leo, rex, ...).
TTS_VOICE=ara
# BCP-47 code or "auto". Polish is not on the official list but works with auto.
TTS_LANGUAGE=auto
# Where synthesized clips are cached so a slide is only paid for once.
TTS_CACHE_DIR=.cache/tts
